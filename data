/*
  SEARCH FUNCTION
  Wannan function zai nemo mafi dacewa da tambayar user.
*/

export function normalizeKnowledgeText(text: string): string {
  return text
    .toLowerCase()
    .trim()
    .replace(/[’‘]/g, "'")
    .replace(/[“”]/g, '"')
    .replace(/\s+/g, " ");
}

export function findKnowledgeItem(
  question: string
): KnowledgeItem | null {
  const normalizedQuestion =
    normalizeKnowledgeText(question);

  let bestMatch: KnowledgeItem | null = null;
  let bestScore = 0;

  for (const item of knowledgeBase) {
    let score = 0;

    for (const keyword of item.keywords) {
      const normalizedKeyword =
        normalizeKnowledgeText(keyword);

      if (
        normalizedQuestion.includes(
          normalizedKeyword
        )
      ) {
        /*
          Doguwar keyword tana samun ƙarin score.
          Misali:
          "imam mahdi" > "mahdi"
        */
        score += normalizedKeyword.length;
      }
    }

    /*
      Tags suna ƙara taimakawa wajen gano topic.
    */
    for (const tag of item.tags) {
      const normalizedTag =
        normalizeKnowledgeText(tag);

      if (
        normalizedQuestion.includes(
          normalizedTag
        )
      ) {
        score += 2;
      }
    }

    if (score > bestScore) {
      bestScore = score;
      bestMatch = item;
    }
  }

  return bestMatch;
}

/*
  CATEGORY SEARCH
*/

export function getKnowledgeByCategory(
  category: string
): KnowledgeItem[] {
  const normalizedCategory =
    normalizeKnowledgeText(category);

  return knowledgeBase.filter(
    (item) =>
      normalizeKnowledgeText(item.category) ===
      normalizedCategory
  );
}

/*
  GET ALL KNOWLEDGE
*/

export function getAllKnowledge(): KnowledgeItem[] {
  return knowledgeBase;
}
